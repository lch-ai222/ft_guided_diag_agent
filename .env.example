# LLM
# Required only for LLM-enhanced classification/intake/report/rerank.
# Rules-only mode works without it.
LLM_PROVIDER=deepseek
LLM_ENABLE=True
OUTPUT_LANGUAGE=zh-CN

# DeepSeek. Put the real key only in local .env, never in code, README, replay, or tests.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_TRANSLATION_MODEL=deepseek-v4-flash

# Backward-compatible OpenAI settings for future provider switching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_ENABLE_LLM=false

# Project-local paths
FAULT_TREE_TTL_PATH=corrected_fault_tree_instances.ttl
RAW_DOCS_DIR=data/raw_docs
CHROMA_DIR=data/chroma
RUNS_DIR=runs
DATASETS_DIR=datasets
TREE_GENERATION_DIR=data/tree_generation
TREE_PROPOSALS_DIR=data/tree_proposals
DIAGNOSIS_MODE=PRODUCTION

# RAG
RAG_COLLECTION_NAME=ft_diag_docs
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
